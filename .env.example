# Copy to .env.local for local development, and set the same values in the
# hosting provider's environment settings for production.

# GoHighLevel inbound webhook that receives every quote-form lead (server-only).
# Without it the form shows an error and the lead is only written to the logs.
GHL_WEBHOOK_URL=

# Vercel Blob token for the optional "Photos of the job" field (server-only).
# Added automatically on Vercel when the Blob store "metro-quote-photos" is
# connected to the project; for local dev run `vercel env pull .env.local`.
# Without it the form still submits; it just notes that photos couldn't attach.
BLOB_READ_WRITE_TOKEN=

# Metro's Google Tag Manager container (GTM-XXXXXXX). Public by design (it ends
# up in the page HTML). Unset = no GTM, so no GA4, Ads, Clarity or call tracking.
NEXT_PUBLIC_GTM_ID=

# Optional fallbacks only — verify Search Console and Bing by DNS TXT instead.
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
